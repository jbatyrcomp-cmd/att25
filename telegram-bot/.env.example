# Telegram Bot sozlamalari
# @BotFather dan olingan bot tokenini kiriting
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Saqlash rejimi:
# 'telegram' -> 100% Bepul, cheksiz xotira, karta talab qilmaydi (TAVSIYA ETILADI!)
# 'local'    -> O'z kompyuteringizdagi storage/ papkasida saqlaydi
# 'gcs'      -> Google Cloud Storage (karta va loyiha kerak bo'ladi)
STORAGE_MODE=telegram

# (Ixtiyoriy) Agar materiallarni o'zingizning Telegram yopiq kanalingizga ham zaxira qilib borishni istasangiz:
ARCHIVE_CHANNEL_ID=

# Maksimal fayl hajmi (Megabaytda)
MAX_FILE_SIZE_MB=50

# Google Cloud Storage (agar STORAGE_MODE=gcs bo'lsa)
GCS_BUCKET_NAME=your-materials-bucket-name
GCS_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcs-key.json
